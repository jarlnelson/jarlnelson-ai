# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real API keys.

# REQUIRED — Anthropic API key for the Ask Jarl agent.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL — Public site URL used in sitemap.xml, robots.txt, canonical links,
# and OG image metadata. Defaults to https://jarlnelson.ai when not set.
# Useful for local dev (http://localhost:3000) or Vercel preview deploys.
NEXT_PUBLIC_SITE_URL=
